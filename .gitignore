/target/
*.pdb
# Release signing key: NEVER commit. Back it up offline and store a copy in
# the release workflow secrets (MPA_MINISIGN_KEY).
packaging/minisign.key
# pdfium shared library, fetched by packaging/fetch-pdfium.ps1
/vendor/pdfium/
# Runtime de WebView2 offline y artefactos del instalador
/vendor/webview2/
/Output/

# Local UI install (npm --prefix crates/desktop/ui install)
crates/desktop/ui/node_modules/

# Regenerated on every build: tauri-build writes gen/, vite writes ui/dist.
# Keeping them out of the index stops `git status` from churning in dev.
crates/desktop/gen/
crates/desktop/ui/dist/
# Tauri CLI install for the desktop shell (npm --prefix crates/desktop install)
crates/desktop/node_modules/
